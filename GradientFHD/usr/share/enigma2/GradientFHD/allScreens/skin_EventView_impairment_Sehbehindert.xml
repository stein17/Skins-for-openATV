<skin>
	<!-- EventView Font 60 -->
<screen name="EventView" position="center,center" size="1450,900" backgroundColor="transparent" flags="wfNoBorder" title="Eventview">
    <widget source="global.CurrentTime" render="Label" position="1250,0" size="180,70" font="Italic; 60" foregroundColor="gradient_foreground_selection" backgroundColor="background" textBorderColor="black" textBorderWidth="1" halign="right" valign="center" transparent="1" zPosition="1">
      <convert type="ClockToText">Default</convert>
    </widget>
    <widget source="global.CurrentTime" render="Label" position="800,0" size="440,70" font="Italic; 60" foregroundColor="gradient_foreground_selection" backgroundColor="background" textBorderColor="black" textBorderWidth="1" halign="left" valign="center" transparent="1" zPosition="1">
        <convert type="ClockToText">Format %a %d %b %Y</convert>
    </widget>
  <widget source="Service" render="Picon" position="1050,100" size="378,213" zPosition="0" transparent="1" alphatest="blend">
    <convert type="ServiceName">Reference</convert>
  </widget>
  <widget name="channel" position="40,-13" size="760,70" font="Italic; 60" halign="left" valign="center" backgroundColor="gradient_background" foregroundColor="gradient_foreground" transparent="1" />
  <eLabel position="1090,453" size="300,6" backgroundColor="gradient_foreground_title" zPosition="1" />
  
  <eLabel text="&lt;" position="1050,430" size="30,50" halign="center" valign="center" font="Gradient_Font; 50" transparent="1" />
  <eLabel text="&gt;" position="1398,430" size="30,50" halign="center" valign="center" font="Gradient_Font; 50" transparent="1" />
  
  
  <widget source="session.RecordState" render="Pixmap" pixmap="infobar/icon_record.png" position="1351,812" size="72,45" zPosition="1" alphatest="blend">
    <convert type="ConditionalShowHide">Blink,2000</convert>
  </widget>
    <eLabel name="setup_bg" position="0,74" size="1450,834" backgroundColor="gradient_BGM,gradient_TBGM,gradient_BGM,vertical" zPosition="-8" />
    <!-- <eLabel name="setup_bg" position="0,64" size="1450,834" backgroundColor="gradient_BGO,gradient_BGM,gradient_BGU,vertical" zPosition="-8" /> -->
    <eLabel name="title_bg" position="0,0" size="1450,80" backgroundColor="gradient_TBGL,gradient_BGO,gradient_BGU,horizontal" zPosition="-9" cornerRadius="12" />
    <eLabel name="title_line" position="0,70" size="1450,4" backgroundColor="gradient_background,gradient_BGLR,gradient_BGLM,horizontal" zPosition="10" />
    
  <panel name="Template_Setup_Base0" />
  


    <widget source="Service" render="Progress" position="1090,441" size="300,30" foregroundColor="gradient_Line" transparent="1" zPosition="2">
      <convert type="EventTime">Progress</convert>
    </widget>
    <eLabel text="-" position="1215,340" size="50,70" halign="center" valign="center" font="Gradient_Font; 80" zPosition="10" transparent="1" />

<widget source="Event" render="Label" position="1050,350" zPosition="2" size="165,70" font="Gradient_Font; 60" halign="left" backgroundColor="gradient_background" foregroundColor="gradient_foreground" transparent="1">
  <convert type="EventTime">StartTime</convert>
  <convert type="ClockToText">Format:%H:%M</convert>
</widget>
<widget source="Event" render="Label" position="1263,350" zPosition="2" size="165,70" font="Gradient_Font; 60" halign="right" backgroundColor="gradient_background" foregroundColor="gradient_foreground" transparent="1">
  <convert type="EventTime">EndTime</convert>
  <convert type="ClockToText">Format:%H:%M</convert>
</widget>
<widget source="Event" render="Label" position="1050,490" size="378,70" font="Gradient_Font;60" transparent="1" halign="center" valign="center" zPosition="99" backgroundColor="gradient_background" foregroundColor="gradient_foreground">
  <convert type="EventTime">Remaining</convert>
  <convert type="RemainingToText">InMinutes</convert>
</widget>
<widget name="epg_description" position="30,90" size="1000,800" font="Gradient_Font; 60" scrollbarMode="showOnDemand" backgroundColor="gradient_background" foregroundColor="gradient_foreground" transparent="1" zPosition="10" borderWidth="1" borderColor="black" />

</screen>
</skin>
