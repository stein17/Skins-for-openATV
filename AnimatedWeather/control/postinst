#!/bin/sh

PLUGIN="/usr/lib/enigma2/python/Plugins/Extensions/AnimatedWeather"
RENDERER="/usr/lib/enigma2/python/Components/Renderer/AnimatedWeatherPixmap"

mkdir -p /usr/share/enigma2/AnimatedWeather/sets
rm -f "${RENDERER}.pyc" "${RENDERER}.pyo"
find "$PLUGIN" -type d -name __pycache__ -prune -exec rm -rf {} \; 2>/dev/null || true
exit 0
