#!/bin/sh

echo "Preparing GradientWQHD skin installation..."

# Remove only stale bytecode owned by GradientWQHD.  GradientFHD may be
# installed at the same time and must never be touched here.
rm -f /usr/lib/enigma2/python/Components/Converter/GradientWQHD*.pyc
rm -f /usr/lib/enigma2/python/Components/Converter/__pycache__/GradientWQHD*.pyc
rm -f /usr/lib/enigma2/python/Components/Renderer/GradientWQHD*.pyc
rm -f /usr/lib/enigma2/python/Components/Renderer/__pycache__/GradientWQHD*.pyc
rm -rf /usr/lib/enigma2/python/Plugins/Extensions/GradientWQHD/__pycache__

exit 0
