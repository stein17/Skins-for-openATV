    <color name="club_selection_fg" value="#0008090c" />
	
    <color name="ScrollbarBorder" value="#00ffd000" />
    <color name="ScrollbarForeground" value="#001a1a1a" />
    <color name="SliderBorder" value="#00ffd000" />
    <color name="SliderForeground" value="#001a1a1a" />
	
	<color name="ch-fg-name" value="cyan" />
	<color name="ch-fg-name-select" value="#00fcfcfc" />
	<color name="ch-fg-event" value="#00fcfcfc" />
	<color name="ch-fg-event-select" value="#00ffbc04" />
	<color name="ch-bg-select" value="#0018171c" />
	<color name="selection_gradient_top" value="#00303036" />
	<color name="selection_gradient_bottom" value="#0008090C" />
	<color name="club_selection_gradient" value="selection_gradient_top,club_selection_bg,selection_gradient_bottom,vertical" />
	<color name="ch_selection_gradient" value="selection_gradient_top,ch-bg-select,selection_gradient_bottom,vertical" />
	<color name="dark_selection_gradient" value="selection_gradient_top,club_dark,selection_gradient_bottom,vertical" />

	
	<color name="fg-title-ib" value="#00fcfcfc" />
	<color name="fg-clock-ib" value="#00ffbc04" />
	<color name="fg-date-ib" value="#00fcfcfc" />
	
	<color name="fg-title-m" value="#0008090c" />
	<color name="fg-title-s" value="#0008090c" />
	<color name="fg-clock-s" value="#0008090c" />
	<color name="fg-date-s" value="#0008090c" />
  </colors>	
  

  
  
 <windowstyle type="skinned" id="0">
    <title offset="60,15" font="Regular;55" borderColor="black" borderWidth="1" />
    <configList entryLeftOffset="29" headerLeftOffset="11" headerFont="Regular;43" entryFont="Regular;43" valueFont="Regular;36" />
    <!-- Allgemeine Fensterfarben -->
    <color name="Background" color="bl_bg" />
    <color name="LabelForeground" color="bl_text" />
    <!-- Listbox normal -->
    <color name="ListboxBackground" color="bl_bg" />
    <color name="ListboxForeground" color="bl_text" />
    <!-- Listbox Auswahl -->
    <color name="ListboxSelectedBackground" color="club_selection_bg" />
    <color name="ListboxSelectedForeground" color="club_selection_fg" />
    <!-- Markierte Einträge -->
    <color name="ListboxMarkedBackground" color="club_selection_bg" />
    <color name="ListboxMarkedForeground" color="club_selection_fg" />
    <color name="ListboxMarkedAndSelectedBackground" color="club_selection_bg" />
    <color name="ListboxMarkedAndSelectedForeground" color="club_selection_fg" />
    <!-- Fenstertitel -->
    <color name="WindowTitleForeground" color="bl_text" />
    <color name="WindowTitleBackground" color="bl_bg" />
    <!-- Scrollbar -->
    <color name="ScrollbarForeground" color="club_primary" />
    <color name="ScrollbarBorder" color="bl_text" /> 
    <!-- Slider -->
    <color name="SliderForeground" color="club_primary" />
    <color name="SliderBorder" color="bl_text" />

    <!-- Borderset -->
    <borderset name="bsWindow">
      <pixmap pos="bpTopLeft" filename="BundesligaWQHD/screens/Yellow/bs_tl.png" />
      <pixmap pos="bpTop" filename="BundesligaWQHD/screens/Yellow/bs_t.png" />
      <pixmap pos="bpTopRight" filename="BundesligaWQHD/screens/Yellow/bs_tr.png" />
      <pixmap pos="bpLeft" filename="BundesligaWQHD/screens/Yellow/bs_l.png" />
      <pixmap pos="bpRight" filename="BundesligaWQHD/screens/Yellow/bs_r.png" />
      <pixmap pos="bpBottomLeft" filename="BundesligaWQHD/screens/Yellow/bs_bl.png" />
      <pixmap pos="bpBottom" filename="BundesligaWQHD/screens/Yellow/bs_b.png" />
      <pixmap pos="bpBottomRight" filename="BundesligaWQHD/screens/Yellow/bs_br.png" />
    </borderset>


    <borderset name="bsListboxEntry">
      <pixmap filename="BundesligaWQHD/screens/Yellow/line_top.png" pos="bpTop" />
      <pixmap filename="BundesligaWQHD/screens/Yellow/line_bottom.png" pos="bpBottom" />
	  <pixmap filename="BundesligaWQHD/screens/Yellow/line_left.png" pos="bpLeft"/>
    </borderset>
    <!-- Scrolllabel -->
    <scrolllabel scrollbarWidth="13" scrollbarBorderWidth="1" scrollbarOffset="7" />
    <!-- Listbox -->
    <listbox scrollbarWidth="13" scrollbarBorderWidth="1" pageSize="0" scrollbarOffset="7" />
  </windowstyle>
  
  	<!-- Header Title Clock Setup-->
	<screen name="Header_Title_Clock_Setup">
		<widget source="Title" render="Label" position="453,72" size="1293,75" font="Regular; 61" noWrap="1" valign="center" halign="center" backgroundColor="title_gradient" foregroundColor="fg-title-s"  transparent="1" zPosition="5" />
		<widget source="global.CurrentTime" render="Label" position="2307,72" size="173,75" font="Regular;61" valign="center" halign="center" backgroundColor="title_gradient" foregroundColor="fg-clock-s"  transparent="1" zPosition="5">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="1867,83" size="427,53" font="Regular; 40" halign="right" valign="center" foregroundColor="fg-date-s" backgroundColor="title_gradient"  transparent="1" zPosition="5">
			<convert type="ClockToText">Format:%A, %d. %B</convert>
		</widget>
	</screen>
	
	    <!-- Header Clock ChannelSelection-->
  <screen name="Header_Clock_ChannelSelection">
      <widget source="global.CurrentTime" render="Label" position="2333,33" size="173,75" font="Regular;61" valign="center" halign="center" backgroundColor="bl_bg" foregroundColor="fg-clock-s" transparent="1" zPosition="5">
      <convert type="ClockToText">Format:%H:%M</convert>
    </widget>
    <widget source="global.CurrentTime" render="Label" position="1867,43" size="427,53" font="Regular; 40" halign="right" valign="center" foregroundColor="fg-date-s" backgroundColor="bl_bg" transparent="1" zPosition="5">
      <convert type="ClockToText">Format:%A, %d. %B</convert>
    </widget>
  </screen>
	
	<!-- Header Title Clock ChannelSelection-->
	<screen name="Header_Title_Clock_ChannelSelection">
		<widget source="Title" render="Label" position="427,33" size="1333,75" font="Regular; 61" noWrap="1" valign="center" halign="center" backgroundColor="title_gradient" foregroundColor="fg-title-s"  transparent="1" zPosition="5" />
		<widget source="global.CurrentTime" render="Label" position="2333,33" size="173,75" font="Regular;61" valign="center" halign="center" backgroundColor="title_gradient" foregroundColor="fg-clock-s"  transparent="1" zPosition="5">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="1867,43" size="427,53" font="Regular; 40" halign="right" valign="center" foregroundColor="fg-date-s" backgroundColor="title_gradient"  transparent="1" zPosition="5">
			<convert type="ClockToText">Format:%A, %d. %B</convert>
		</widget>
	</screen> 
    <!--   MessageBox -->
  	 <screen name="MessageBox_list">
    <widget name="list" position="20,280" size="1560,480" padding="13,0" itemHeight="72" font="Regular;40" scrollbarMode="showOnDemand" backgroundColorSelected="dark_selection_gradient"  foregroundColorSelected="bl_text" backgroundColor="bl_bg" foregroundColor="bl_text" transparent="1" />
 </screen>
